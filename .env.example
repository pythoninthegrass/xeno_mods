# Precedence: process environment, then this file copied to .env, then the built-in default.
# Every key is optional. Keys marked "per platform" have a different built-in default on macOS
# (CrossOver) and Linux (Proton); both defaults are shown.

# Wine prefix drive_c; DATA_DIR derives from it, and so does GAME_DIR on macOS. Per platform
# BOTTLE=~/Library/Application Support/CrossOver/Bottles/Steam/drive_c
# BOTTLE=~/.steam/steam/steamapps/compatdata/538030/pfx/drive_c
# Game install. Inside the bottle under CrossOver, outside the prefix under Proton. Per platform
# GAME_DIR={bottle}/Program Files (x86)/Steam/steamapps/common/Xenonauts2
# GAME_DIR=~/.steam/steam/steamapps/common/Xenonauts2
# DATA_DIR=
# Prefix user that owns AppData; names the save path the mod is told to load. Per platform
# WINE_USER=crossover
# WINE_USER=steamuser
# CrossOver app bundle that launches the game through Steam. Unset on Linux. Per platform
# LAUNCHER_APP=~/Applications/CrossOver/Steam/Xenonauts 2.app
# Baseline save to load, relative to DATA_DIR
# SAVE_REL=Saves/ellz_1bf479e6/auto/auto_groundcombat_turn_10_start-62.json

# How the game is started. Shell-quoted; {app} is replaced with LAUNCHER_APP. Per platform
# LAUNCH_CMD=open '{app}'
# LAUNCH_CMD=steam steam://rungameid/538030
# How a click is posted. Shell-quoted; {x} and {y} are replaced with the point. Per platform
# The macOS default is an inline osascript -l JavaScript program and has no one-line form
# CLICK_CMD=xdotool mousemove {x} {y} click 1

# Seconds to wait for the game process (and menu in --load menu) after launch
# LAUNCH_TIMEOUT=60
# Seconds to wait for the playable marker after the save is queued
# LOAD_TIMEOUT=120
# Seconds to wait for the game to exit on SIGTERM before SIGKILL
# QUIT_GRACE=15
# Seconds between log and process polls
# POLL_INTERVAL=0.5

# Click points for --load menu (screen x,y): LOAD GAME, first Turn 10 save row, LOAD SAVE
# The defaults are 2560x1440 macOS coordinates; set them for your display
# MENU_LOAD_GAME=1331,1302
# MENU_SAVE_ROW=947,426
# MENU_LOAD_SAVE=960,1112

# Click points for --warm-loads (screen x,y): the in-game menu button, LOAD GAME, the same Turn 10 save row in the in-game load list
# The load button is MENU_LOAD_SAVE. Rows are positional: every extra save shifts the list by 55 px
# GAME_MENU_BUTTON=54,54
# GAME_MENU_LOAD_GAME=1280,760
# GAME_MENU_SAVE_ROW=896,426

# Mod folder under DATA_DIR/Mods that holds auto_load.txt and unity_experiment.txt
# MOD_NAME=x2_load_profiler
# Leftover logs from before a run go to Logs/<prefix><run-name>
# LEFTOVER_ARCHIVE_PREFIX=pre-
# Case-insensitive regex counted as a state-loss match
# STATE_LOSS_PATTERN=state-loss
# Log text that marks the game as playable
# PLAYABLE_MARKER=GCUI: BlockOnLocalPlayerTurn
# Log text that marks the main menu as ready (--load menu)
# MENU_READY_MARKER=XenonautsLoadScreen: Outro Complete
# Steam client log read by the cloud-sync preflight check. Per platform
# STEAM_CONSOLE_LOG={bottle}/Program Files (x86)/Steam/logs/console_log.txt
# STEAM_CONSOLE_LOG=~/.steam/steam/logs/console_log.txt
# pgrep -f patterns; the bracket keeps them from matching the pgrep command line itself
# GAME_PROCESS_PATTERN=[X]enonauts2.exe
# STEAM_PROCESS_PATTERN=[s]team.exe
# STEAM_PROCESS_PATTERN=[s]teamwebhelper
