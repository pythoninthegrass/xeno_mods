{
  "mcpServers": {
    "backlog": {
      "command": "backlog",
      "args": [
        "mcp",
        "start"
      ]
    },
    "context7": {
      "command": "npx",
      "args": [
        "-y",
        "@upstash/context7-mcp"
      ]
    },
    "osascript": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/pythoninthegrass/osascript-mcp",
        "osascript-mcp"
      ]
    },
    "serena": {
      "command": "uvx",
      "args": [
        "--from",
        "git+https://github.com/oraios/serena",
        "serena",
        "start-mcp-server",
        "--context",
        "ide",
        "--project-from-cwd"
      ]
    }
  }
}
